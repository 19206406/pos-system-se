{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "PosSystem.Api",
    "Audience": "PosSystem.Clients",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "SessionAbsoluteLifetimeDays": 7,
    "ClockSkewSeconds": 30
  },
  "PasswordTokens": {
    "InviteLifetimeHours": 72,
    "ResetLifetimeMinutes": 30
  },
  "IdentityLinks": {
    "FrontendBaseUrl": "",
    "SetPasswordPath": "/set-password"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "FromAddress": "",
    "FromName": "MiPOS"
  },
  "Outbox": {
    "PollingIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "LockSeconds": 60
  },
  "Retention": {
    "RetentionDays": 30,
    "IntervalMinutes": 60
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminFullName": "Administrador"
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
